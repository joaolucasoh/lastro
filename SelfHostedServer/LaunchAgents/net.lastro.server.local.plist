<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>net.lastro.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__LASTRO_DIR__/start-server.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__LASTRO_DIR__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/lastro-server.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/lastro-server.err.log</string>
</dict>
</plist>
